# Copia questo file in .env e compila i valori
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# PostgreSQL (Docker su porta 5433)
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5433/rag_db

# Redis (Docker su porta 6379)
REDIS_URL=redis://localhost:6379/0

# Modello embedding (locale, nessuna API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Modello Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Chunk size (caratteri) — v2: più piccoli per precisione maggiore
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Quanti chunk recuperare per la query
TOP_K=5

# Directory upload temporanei (relativa alla root del progetto)
UPLOAD_DIR=uploads
